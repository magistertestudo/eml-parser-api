# Impostare le variabili nel servizio Railway; non commettere credenziali.
OPENAI_API_KEY=
PCLOUD_ENABLED=false
PCLOUD_ACCESS_TOKEN=
# Host restituito da OAuth: api.pcloud.com (US), eapi.pcloud.com (EU)
PCLOUD_API_HOST=
PCLOUD_PARENT_FOLDER_ID=
# Link di raccolta file, NON link condiviso lettura+upload.
PCLOUD_LINK_MODE=upload_request
