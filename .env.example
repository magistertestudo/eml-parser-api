# Impostare le variabili nel servizio Railway; non commettere credenziali.
OPENAI_API_KEY=
PCLOUD_ENABLED=false
PCLOUD_AUTH_TYPE=direct
PCLOUD_AUTH_TOKEN=
# Solo per la modalità oauth:
PCLOUD_ACCESS_TOKEN=
# Destinazione confermata: IN-SAFETY-2026, dal link pubblico fornito.
# Il token deve appartenere al proprietario sul server US.
PCLOUD_API_HOST=api.pcloud.com
PCLOUD_PARENT_FOLDER_ID=29662386698
# Link di raccolta file, NON link condiviso lettura+upload.
PCLOUD_LINK_MODE=upload_request
